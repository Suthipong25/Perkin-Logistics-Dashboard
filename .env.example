# --- PostgreSQL Connections ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/perkin_logistics?schema=public"
DATABASE_URL_WEB="postgresql://postgres:password@localhost:5432/perkin_logistics?schema=public"
DATABASE_URL_INGEST="postgresql://postgres:password@localhost:5432/perkin_logistics?schema=public"

PGHOST="localhost"
PGPORT=5432
PGDATABASE="perkin_logistics"
PGUSER="postgres"
PGPASSWORD=""

# --- Storage & Security ---
RAW_STORAGE_DIR="C:/perkin-logistics/data/raw"
MAX_UPLOAD_BYTES=26214400
WEBHOOK_HMAC_SECRET="your-webhook-hmac-secret"
AUTH_SESSION_SECRET="your-auth-session-secret"

# --- Python & Master Paths ---
PYTHON_PATH="python"
SNAPSHOTS_MANIFEST=""
BACKUPS_SNAPSHOTS_DIR=""

# Access protection (Basic Auth)
APP_AUTH_USER=perkin
APP_AUTH_PASSWORD=
